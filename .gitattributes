# Line endings
#
# `core.autocrlf=true` is set on the Windows machines this repo is developed on,
# which means git decides per file whether something is text — and it guesses.
# It guessed wrong on the brand PNG: 200,187 bytes went in and 153,932 came back
# out, a corrupted image that still had a valid name and sat in the working tree
# looking fine until someone opened it.
#
# So the rule is written down instead of inferred.
* text=auto eol=lf

# Binary. Never touch the bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.mp4 binary
*.webm binary
*.zip binary
*.sqlite binary
*.sqlite3 binary

# Windows-native tooling reads these; leave their endings alone.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
