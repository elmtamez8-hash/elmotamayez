# Frontend environment variables
# Copy to .env.local and adjust as needed

# API base URL (backend Laravel server)
# In development, Next.js proxies /api to this URL via rewrites in next.config.ts
NEXT_PUBLIC_API_URL=http://localhost:8000

# Support number in E.164 without the leading "+". Empty means the floating
# WhatsApp button does not render — there is no safe placeholder for a phone number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# The product name is NOT here any more. It is a `platform_settings` row, edited
# at /admin/platform-settings and read at run time through GET /api/v1/platform.
# `NEXT_PUBLIC_*` is inlined at BUILD time, so the old key could only change by
# rebuilding — and it was set nowhere on the server, so the live site read the
# placeholder «منصّتي» in every title, header and footer for months with nothing
# failing anywhere. Measured 2026-08-31.
#
# Where the SERVER reaches the API. It is the same origin `next.config.ts` uses
# as its rewrite destination — the rewrite serves the browser, and a fetch that
# runs in Node has no origin to resolve a relative /api path against. Not
# NEXT_PUBLIC_: nothing in the browser needs it.
API_ORIGIN=http://localhost:8000

# Live delivery (spec 010). The KEY and the HOST are public by protocol — the
# browser dials the socket and the key names the app; `REVERB_APP_SECRET` signs
# and stays on the server. With no key set the chat still works: it fetches
# instead of listening, which is the same path an outage takes.
#
# ⚠️ THE HOST AND THE SCHEME ARE LEFT EMPTY ON PURPOSE, and both used to carry a
# literal. `echo.ts` follows the page with `window.location` when they are unset,
# which is the only value that is right for every address one build is opened
# from: `localhost` here made a phone that loaded the page from `192.168.x.x:3000`
# dial its OWN localhost — no live chat, and no error saying why — and `http`
# makes any https page refuse the socket outright as mixed content. Set them in
# production, where the socket sits behind a proxy on a different host and port.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_SCHEME=

# The public site's own absolute origin — the sitemap's <loc>, robots' Sitemap:
# line, every canonical, and the url in every JSON-LD block. NOT NEXT_PUBLIC_*:
# every reader is a server component, and a NEXT_PUBLIC_ value is inlined at
# compile time. Left empty outside production it falls back to localhost:3000.
SITE_URL=

# Web push (spec 012 · US2). The PUBLIC half of the VAPID pair — it is public by
# protocol: the browser needs it to subscribe at all, and it is the `iss` claim of
# the JWT the server signs. `VAPID_PRIVATE_KEY` signs and lives only in the
# backend's environment; a copy of it here would be inlined into every JavaScript
# bundle the product serves.
#
# ⚠️ EMPTY MEANS THE FEATURE IS SIMPLY OFF, and that is the correct behaviour:
# `pushSupported()` answers false, the card on /settings/notifications does not
# offer anything, and every other notification path is untouched.
#
# ⚠️ AND IT IS INLINED AT COMPILE TIME. Editing this and restarting the dev server
# in the wrong order ships the old value with nothing to say so.
#
# Generate a pair with:  php artisan tinker  →  Minishlink\WebPush\VAPID::createVapidKeys()
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
