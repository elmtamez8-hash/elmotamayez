# Frontend environment variables
# Copy to .env.local and adjust as needed

# API base URL (backend Laravel server)
# In development, Next.js proxies /api to this URL via rewrites in next.config.ts
NEXT_PUBLIC_API_URL=http://localhost:8000

# Support number in E.164 without the leading "+". Empty means the floating
# WhatsApp button does not render — there is no safe placeholder for a phone number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# The product name. PRODUCT.md records «المتميز» as a binding brand commitment;
# without this key lib/platform.ts falls back to the placeholder «منصّتي», which
# is what every title, header and footer shipped until 2026-08-11.
NEXT_PUBLIC_PLATFORM_NAME=المتميز
