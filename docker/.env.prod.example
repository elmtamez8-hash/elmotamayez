# ══════════════════════════════════════════════════════════════════════════
#  إعداداتُ النشرةِ الإنتاجيّة — يُنسَخُ إلى `docker/.env` **على الخادم فقط**
# ══════════════════════════════════════════════════════════════════════════
#
# ⚠️ `docker/.env` مُستثنًى في `.gitignore` ويجبُ أن يبقى كذلك. مفتاحُ توقيعٍ في
# المستودعِ يظلُّ في التاريخِ بعدَ حذفِه، وتدويرُه يعني نشرةً جديدةً لا commit.
#
#   cp docker/.env.prod.example docker/.env
#   nano docker/.env          # املأ ما تحته خطّ
#
# ولتوليدِ سرٍّ عشوائيٍّ على الخادم:   openssl rand -hex 32

# ── الهُويّة والنطاق ──────────────────────────────────────────────────────
DOMAIN=example.com
APP_NAME="المتميز"
APP_ENV=production
# ⚠️ `false` وليس شيئاً آخَر. صفحةُ خطأ Laravel في وضعِ التنقيحِ تعرضُ الاستعلامَ
# **مع قيمِه المربوطة** — أي اسمَ الطالبِ ورقمَه — لأيِّ زائرٍ يُصادِفُ خطأً.
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=ar

# ⚠️ يُولَّدُ مرّةً واحدةً على الخادمِ ولا يتغيّرُ بعدَها أبداً:
#   docker compose -f docker/docker-compose.prod.yml run --rm backend php artisan key:generate --show
# تغييرُه يُبطِلُ كلَّ جلسةٍ وكلَّ قيمةٍ مشفَّرةٍ في قاعدةِ البيانات، بلا رجعة.
APP_KEY=

# ── قاعدة البيانات ───────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=mteatch
DB_USERNAME=mteatch
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── الذاكرة والطوابير والجلسات ───────────────────────────────────────────
# ⚠️ `redis` في الثلاثة. `QUEUE_CONNECTION=sync` يُشغِّلُ كلَّ مهمّةٍ **داخلَ**
# الطلبِ الذي أطلقَها: رفعُ تسجيلٍ يصيرُ طلباً بدقائق، وفشلُه يُسقِطُ الفعلَ الذي
# لا علاقةَ له به. وهو أيضاً ما يُبطِلُ `->delay()` تماماً — التأخيرُ ميزةُ طابور.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_PORT=6379

# ── البحث ────────────────────────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_KEY=

# ── السوكِت (Reverb) ─────────────────────────────────────────────────────
#
# ⚠️ `REVERB_APP_SECRET` يُوقِّعُ ولا يغادرُ الخادم. `REVERB_APP_KEY` يُسمّي
# التطبيقَ ويُرسَلُ إلى المتصفّحِ بالضرورةِ — معياران يمنعان الاثنَين معاً معيارٌ
# لا يمكنُ تحقيقُه.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ⚠️ وما يراه **المتصفّح** مختلفٌ عن الأعلى: المضيفُ هو النطاقُ العامُّ، والمنفذُ
# ٤٤٣، والنظامُ `https` — لأنّ الطلبَ يمرُّ من nginx على `/app`. كتابةُ `localhost`
# هنا تجعلُ هاتفَ الطالبِ يطلبُ سوكِتَ **نفسِه**، و`http` في صفحةِ `https` يُرفَضُ
# كمحتوًى مختلَطٍ — والنقاشُ في الحالتَين «يعملُ متأخّراً» بلا خطأٍ يُسمّي السبب.
REVERB_PUBLIC_HOST=example.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

# ── البثّ المباشر (LiveKit) ──────────────────────────────────────────────
#
# ⚠️ `LIVEKIT_URL` بصيغةِ `wss://` لأنّ **المتصفّحَ** يطلبُه؛ والمُهايئُ يشتقُّ
# صيغةَ HTTP بنفسِه. وضعُ `https://` هنا يكسرُ العميلَ، ووضعُ `wss://` كان قد
# كسرَ الخادمَ قبلَ أن يُشتَقَّ العنوانُ — عنوانان لمضيفٍ واحدٍ يتباعدان.
BROADCAST_PROVIDER=livekit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── الوسائط (Bunny Stream) ───────────────────────────────────────────────
#
# ⚠️ هذان المفتاحان مطلوبٌ تدويرُهما (بندٌ مفتوحٌ منذ جلسةٍ سابقة). ويعيشان في
# البيئةِ لا في `platform_settings`: ذلك الجدولُ يقرؤه كلُّ من يفتحُ لوحةَ الإدارة،
# ومفتاحُ توقيعٍ فيه يُوسِّعُ «من يستطيعُ سكَّ رمزِ تشغيلٍ صالح» من مديرِ الخادمِ
# إلى مديرِ أيِّ مساحةِ عمل. السقوفُ (الحجمُ والمدّة) هي التي تأتي من هناك.
MEDIA_PROVIDER=bunny
BUNNY_LIBRARY_ID=
BUNNY_STREAM_ACCESS_KEY=
BUNNY_PULL_ZONE_HOSTNAME=
BUNNY_PULL_ZONE_SECURITY_KEY=

# ── واتساب ───────────────────────────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── البريد ───────────────────────────────────────────────────────────────
#
# ⚠️ البريدُ ليس قناةَ إشعارٍ في هذا المنتَج، لكنّ استعادةَ كلمةِ المرورِ وتوثيقَ
# البريدِ يمرّان منه — وكلاهما أصلُ مصادقةٍ لا إشعارُ نطاق. رسالةُ استعادةٍ تصلُ
# داخلَ التطبيقِ لا يقرؤها **بالتعريف** من لا يستطيعُ الدخول.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com

# ── خلفَ وكيل ─────────────────────────────────────────────────────────────
#
# ⚠️ بدونها يبني Laravel كلَّ رابطٍ مطلقٍ بـ`http` (لأنّ FPM يرى طلبَ nginx
# الداخليّ)، فتخرجُ روابطُ التحقّقِ من الشهاداتِ وروابطُ الاستعادةِ بنظامٍ خاطئ،
# ويصيرُ `secure` على الكوكيز خاطئاً معه.
TRUSTED_PROXIES=*
