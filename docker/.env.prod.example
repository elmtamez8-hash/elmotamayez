# ══════════════════════════════════════════════════════════════════════════
#  إعداداتُ النشرةِ الإنتاجيّة — يُنسَخُ إلى `docker/.env` **على الخادم فقط**
# ══════════════════════════════════════════════════════════════════════════
#
# ⚠️ `docker/.env` مُستثنًى في `.gitignore` ويجبُ أن يبقى كذلك. مفتاحُ توقيعٍ في
# المستودعِ يظلُّ في التاريخِ بعدَ حذفِه، وتدويرُه يعني نشرةً جديدةً لا commit.
#
#   cp docker/.env.prod.example docker/.env
#   nano docker/.env          # املأ ما تحته خطّ
#
# ولتوليدِ سرٍّ عشوائيٍّ على الخادم:   openssl rand -hex 32

# ── الهُويّة والنطاق ──────────────────────────────────────────────────────
DOMAIN=example.com
APP_NAME="المتميز"
APP_ENV=production
# ⚠️ `false` وليس شيئاً آخَر. صفحةُ خطأ Laravel في وضعِ التنقيحِ تعرضُ الاستعلامَ
# **مع قيمِه المربوطة** — أي اسمَ الطالبِ ورقمَه — لأيِّ زائرٍ يُصادِفُ خطأً.
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=ar

# ⚠️ الافتراضُ `en` عن قصد، ولا يُغيَّرُ إلى `ar`. مفتاحُ ترجمةٍ ناقصٌ في حزمةٍ
# يسقطُ إلى الإنجليزيّةِ — جملةٌ مفهومةٌ — بينما `ar` هنا تجعلُه يطبعُ **المفتاحَ
# نفسَه** على الشاشة (`filament-panels::layout.direction`). ملفُّ الاختباراتِ
# يضعُ `ar` عمداً ليكونَ أقسى من الإنتاج، لا العكس.
APP_FALLBACK_LOCALE=en

# ⚠️ يُولَّدُ مرّةً واحدةً على الخادمِ ولا يتغيّرُ بعدَها أبداً:
#   docker compose -f docker/docker-compose.prod.yml run --rm backend php artisan key:generate --show
# تغييرُه يُبطِلُ كلَّ جلسةٍ وكلَّ قيمةٍ مشفَّرةٍ في قاعدةِ البيانات، بلا رجعة.
APP_KEY=

# ── قاعدة البيانات ───────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=elmotamayez
DB_USERNAME=elmotamayez
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── الذاكرة والطوابير والجلسات ───────────────────────────────────────────
# ⚠️ `redis` في الثلاثة. `QUEUE_CONNECTION=sync` يُشغِّلُ كلَّ مهمّةٍ **داخلَ**
# الطلبِ الذي أطلقَها: رفعُ تسجيلٍ يصيرُ طلباً بدقائق، وفشلُه يُسقِطُ الفعلَ الذي
# لا علاقةَ له به. وهو أيضاً ما يُبطِلُ `->delay()` تماماً — التأخيرُ ميزةُ طابور.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_PORT=6379

# ── البحث ────────────────────────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_KEY=
# يُضبَطُ في ملفِّ الحزمة؛ الافتراضيُّ `localhost` وهو داخلَ الحاويةِ لا شيء.
MEILISEARCH_HOST=http://meilisearch:7700

# ── السوكِت (Reverb) ─────────────────────────────────────────────────────
#
# ⚠️ `REVERB_APP_SECRET` يُوقِّعُ ولا يغادرُ الخادم. `REVERB_APP_KEY` يُسمّي
# التطبيقَ ويُرسَلُ إلى المتصفّحِ بالضرورةِ — معياران يمنعان الاثنَين معاً معيارٌ
# لا يمكنُ تحقيقُه.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ⚠️ وما يراه **المتصفّح** مختلفٌ عن الأعلى: المضيفُ هو النطاقُ العامُّ، والمنفذُ
# ٤٤٣، والنظامُ `https` — لأنّ الطلبَ يمرُّ من nginx على `/app`. كتابةُ `localhost`
# هنا تجعلُ هاتفَ الطالبِ يطلبُ سوكِتَ **نفسِه**، و`http` في صفحةِ `https` يُرفَضُ
# كمحتوًى مختلَطٍ — والنقاشُ في الحالتَين «يعملُ متأخّراً» بلا خطأٍ يُسمّي السبب.
REVERB_PUBLIC_HOST=example.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

# ── البثّ المباشر (LiveKit) ──────────────────────────────────────────────
#
# ⚠️ `LIVEKIT_URL` بصيغةِ `wss://` لأنّ **المتصفّحَ** يطلبُه؛ والمُهايئُ يشتقُّ
# صيغةَ HTTP بنفسِه. وضعُ `https://` هنا يكسرُ العميلَ، ووضعُ `wss://` كان قد
# كسرَ الخادمَ قبلَ أن يُشتَقَّ العنوانُ — عنوانان لمضيفٍ واحدٍ يتباعدان.
BROADCAST_PROVIDER=livekit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── تسجيلُ الحصص (egress ← R2) ─────────────────────────
#
# ⚠️ بدونها يعملُ البثُّ المباشرُ و**لا يُحفَظُ تسجيل**، والأثرُ ليس فيديو
# مفقوداً وحده: `PackageCompletion` يحجزُ أجرَ المدرّسِ لأيّةِ حصّةٍ تسجيلُها
# ليس `published`/`failed`/`no_course` — فحصّةٌ دُرّسَتْ فعلاً يبقى أجرُها موقوفاً.
#
# Bunny ليس متوافقاً مع S3، لذا يكتبُ egress إلى R2 ثمّ يُسحَبُ منه.
# وقرصُ `r2` في `config/filesystems.php` يقرأُ **هذهِ المفاتيحَ نفسَها**، فلا ثانيةَ لها.
LIVEKIT_EGRESS_BUCKET=
LIVEKIT_EGRESS_ENDPOINT=
LIVEKIT_EGRESS_REGION=auto
LIVEKIT_EGRESS_KEY=
LIVEKIT_EGRESS_SECRET=

# القرصُ الذي كتبَ عليه egress التسجيلَ، ومنه يُوقَّعُ الرابطُ الذي يسحبُه Bunny.
#
# ⚠️ `r2` في الإنتاج دائماً، و**`local` ليست قيمةً صحيحةً أبداً** — والسطرُ الذي
# كان هنا يقترحُها هو الذي أوقعَ نشرةً في ذلك بالفعل (2026-09-03). الملفُّ يكتبُه
# egress في الحاويةِ أعلاه، لا على قرصِ الخادم؛ وبـ`local` يوقّعُ
# `FetchableSourceUrl` مفتاحاً على `storage/app/private` حيثُ لا شيء. وقرصُ
# `local` عندنا `serve => true`، فيُصدِرُ رابطاً موقَّعاً **سليمَ الشكلِ لملفٍّ
# غيرِ موجود**: يقبلُه Bunny، ويستقبلُ ٤٠٤ من خادمِنا، ولا سطرَ في أيِّ سجلّ.
# الثمنُ ٤٨ ساعةً من أجرِ مدرّسٍ محجوزٍ ثمّ «التسجيلُ غيرُ متاح» لكلِّ طالب.
#
# والفراغُ يعني «الرابطُ المُسلَّمُ صالحٌ للسحبِ كما هو» — تشغيلٌ محلّيٌّ على ملفٍّ
# عامّ، لا نشرةُ إنتاج.
MEDIA_SOURCE_DISK=r2

# ── الوسائط (Bunny Stream) ───────────────────────────────────────────────
#
# ⚠️ هذان المفتاحان مطلوبٌ تدويرُهما (بندٌ مفتوحٌ منذ جلسةٍ سابقة). ويعيشان في
# البيئةِ لا في `platform_settings`: ذلك الجدولُ يقرؤه كلُّ من يفتحُ لوحةَ الإدارة،
# ومفتاحُ توقيعٍ فيه يُوسِّعُ «من يستطيعُ سكَّ رمزِ تشغيلٍ صالح» من مديرِ الخادمِ
# إلى مديرِ أيِّ مساحةِ عمل. السقوفُ (الحجمُ والمدّة) هي التي تأتي من هناك.
MEDIA_PROVIDER=bunny

# ⚠️ الأسماءُ هي ما يقرؤه `config/media.php` حرفيّاً. كان هذا الملفُ يكتبُ
# `BUNNY_LIBRARY_ID` و`BUNNY_PULL_ZONE_HOSTNAME` — مفتاحان **لا يقرؤهما أحد**.
# فمن يملأُ القيمتين يحصلُ على مكتبةٍ فارغةٍ ومنطقةٍ فارغة: كلُّ رفعٍ
# يفشلُ وكلُّ تشغيلٍ يفشل، والإعدادُ يبدو مكتملاً لمن يقرأُ الملف.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_ACCESS_KEY=
BUNNY_PULL_ZONE=
BUNNY_PULL_ZONE_SECURITY_KEY=

# ── واتساب ───────────────────────────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── البريد ───────────────────────────────────────────────────────────────
#
# ⚠️ البريدُ ليس قناةَ إشعارٍ في هذا المنتَج، لكنّ استعادةَ كلمةِ المرورِ وتوثيقَ
# البريدِ يمرّان منه — وكلاهما أصلُ مصادقةٍ لا إشعارُ نطاق. رسالةُ استعادةٍ تصلُ
# داخلَ التطبيقِ لا يقرؤها **بالتعريف** من لا يستطيعُ الدخول.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com

# ── خلفَ وكيل ─────────────────────────────────────────────────────────────
#
# ⚠️ بدونها يبني Laravel كلَّ رابطٍ مطلقٍ بـ`http` (لأنّ FPM يرى طلبَ nginx
# الداخليّ)، فتخرجُ روابطُ التحقّقِ من الشهاداتِ وروابطُ الاستعادةِ بنظامٍ خاطئ،
# ويصيرُ `secure` على الكوكيز خاطئاً معه.
#
# ⛔ و**ليست `*` أبداً** — وهو ما كان هذا السطرُ يقولُه، ونُقِلَ إلى الإنتاجِ منه.
# `*` لا تعني «صدِّقِ الوكيلَ الذي نادى»: دالّةُ لارافل المُسمّاةُ بذلك تكتبُ
# `['0.0.0.0/0', '::/0']` — كلَّ عنوانٍ في IPv4 وIPv6 (اقرأِ الإسناد، لا اسمَ
# الدالّة). وnginx عندَنا يستعملُ `$proxy_add_x_forwarded_for` فيُلحِقُ ولا
# يستبدل، فتبقى قيمةُ العميلِ في أقصى اليسارِ وهي ما يستقرُّ عليه سيمفوني.
# فيصيرُ `$request->ip()` **ما يكتبُه الزائرُ عن نفسِه**: تسعةُ محدِّداتِ معدّلٍ
# تُتخطّى بتدويرِ ترويسة (دخولٌ وتسجيلٌ بلا سقف)، و`terms_consents.ip_address`
# — العمودُ الموجودُ ليُتَّكَأَ عليه في نزاع — يصيرُ من كتابةِ الخصم، و
# `VerifyWebhookSource` (قائمةُ عناوينِ بوّابةِ الدفع) يصيرُ باباً لا حارساً.
#
# والقيمةُ هي شبكةُ دوكر الداخليّةُ وحدَها: nginx هي الوكيلُ الوحيد، وحاويةُ
# `backend` لا تنشرُ منفذاً، فلا يبلغُها أحدٌ من خارجِ تلك الشبكة. وكيلٌ ثانٍ
# أمامَها (كلاودفلير مثلاً) يُوسِّعُ القائمةَ ولا يُعيدُها إلى `*`.
TRUSTED_PROXIES=172.16.0.0/12
