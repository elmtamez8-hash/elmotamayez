APP_NAME="المتميز"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# The load balancers this app sits behind, comma separated (or "*" only where the
# proxy always overwrites X-Forwarded-For). Empty trusts nothing, so $request->ip()
# is the balancer's address — which is what `terms_consents.ip_address` records
# until this is set. A wildcard behind no proxy is worse: every client then picks
# its own address in that record.
TRUSTED_PROXIES=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.localhost

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:3000,127.0.0.1:8000

# ⚠️ `log` IS THE SHIPPED DEFAULT AND THAT IS DELIBERATE (spec 010). The database
# is the source of a message and the socket is only an accelerator, so a checkout
# that never starts `php artisan reverb:start` still saves, reads and paginates
# every conversation — it simply does not deliver without a refresh. Flipping this
# to `reverb` is what turns live delivery on, and it needs the four REVERB_* values
# at the bottom of this file plus that third permanent process.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Notification delivery runs on its own queues (notifications-high, notifications)
# so a burst of reminders cannot stall the rest of the system. The queue NAMES are
# what gives that separation, and they work on any driver.
#
# Local dev stays on `database`: phpredis is not part of the local setup, and a
# `redis` default here fails every fresh checkout with "Class Redis not found" the
# first time anything is queued. Production runs redis — docker/docker-compose.yml
# sets it — and Horizon is configured for both notification queues.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
# Indexing is QUEUED: a save pushes a job and the request returns without
# waiting for Meilisearch. Without this, a search engine that is down turns
# every course write into a 500 — the row lands, the response fails.
# The trade is real: search becomes eventually consistent, and a failure moves
# from a loud 500 to a quiet row in `failed_jobs`. It needs a worker running.
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
# Meilisearch master key — required in production, leave empty for local dev without auth
MEILISEARCH_KEY=

# Horizon (queue dashboard) — requires Redis + pcntl extension
HORIZON_NAME=Mteatch
HORIZON_PATH=horizon
HORIZON_DOMAIN=
# Where a "queue is backing up" notice goes. Empty means nobody is told — which
# is fine locally and is a payments outage nobody hears about in production.
HORIZON_NOTIFICATION_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Keeps one super-admin password across re-seeds. Leave empty for a random
# one printed at seed time. Local/dev only — the seeder skips production.
SUPER_ADMIN_PASSWORD=

# Video pipeline (spec 004). `local` needs no external account and no network:
# it stores on the private disk and streams by range request, which is what
# lets a grant expire mid-file. A commercial provider (Bunny, Cloudflare, Mux)
# is a second file in Modules/Media/Providers plus a case in the provider —
# nothing in the lesson or session logic changes.
MEDIA_PROVIDER=local
MEDIA_DISK=local
MEDIA_MAX_SIZE_BYTES=2147483648
MEDIA_MAX_DURATION_SECONDS=14400
MEDIA_GRANT_TTL_SECONDS=300
MEDIA_GRANT_RENEW_INTERVAL=60
MEDIA_MAX_RENEWALS=480

# Bunny Stream (spec 019). Set MEDIA_PROVIDER=bunny to switch; `local` stays the
# default and the whole test suite runs on it.
#
# ⚠️ FOUR SECRETS, ALL OF THEM HERE AND NONE IN platform_settings — a row in that
# table is readable by everyone who can open the admin panel, and a leaked signing
# key mints valid playback tokens with no trace in our logs (FR-020أ). Names here,
# values never.
#
# The ACCESS KEY manages videos (fetch, status, delete) and is scoped to the one
# library. The SECURITY KEY signs playback URLs on the pull zone — a different
# credential for a different question, and neither is ever put in a payload.
#
# ⚠️ BUNNY_TITLE_PREFIX IS A JOIN KEY, NOT A LABEL. `videos/fetch` does not return
# the new video's id, so the title is how it is found again (research §R3).
# Changing this prefix orphans every asset whose id has not been recovered yet.
#
# MEDIA_SOURCE_DISK is the bucket a fetch reads FROM — the same one the
# LIVEKIT_EGRESS_* variables below name. It sits outside the BUNNY_* group on
# purpose: the signing is done for WHICHEVER provider is ingesting, and a shared
# class naming a vendor fails ProviderNameContainmentTest. The old BUNNY_SOURCE_*
# names are still read as a fallback so a deployed .env keeps working.
# Empty means "the URL is already fetchable", which is what a local run wants.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_ACCESS_KEY=
BUNNY_PULL_ZONE=
BUNNY_PULL_ZONE_SECURITY_KEY=
BUNNY_TITLE_PREFIX=mteatch
MEDIA_SOURCE_DISK=r2
MEDIA_SOURCE_URL_TTL_MINUTES=120

# Grace period before an admin account without 2FA loses sensitive operations.
TWO_FACTOR_GRACE_DAYS=14

# Payment gateway (spec 007).
#
# ⚠️ NO SIGNING KEY HERE YET, AND ITS ABSENCE IS THE STATEMENT — not a blank to
# be filled in from memory later. The real gateway adapter is deferred (Q8):
# until one exists there is nothing to verify a signature against, and
# ManualTransferProvider::verifySignature() refuses every callback outright. An
# adapter brings its own key names with it, listed here with no value, and
# never with one in the repository (FR-010).
#
# PAYMENTS_WEBHOOK_ALLOWED_IPS is comma-separated. Empty means NOT CONFIGURED,
# never "allow everything": the signature is the guard and the address list is
# only defence in depth beside it.
PAYMENTS_WEBHOOK_ALLOWED_IPS=
PAYMENTS_PENDING_TIMEOUT_MINUTES=
PAYMENTS_CALLBACK_MAX_ATTEMPTS=

# Live room provider (spec 017).
#
# ⚠️ LAUNCH RULE — READ BEFORE SETTING THIS: do NOT set `livekit` in production
# before MEDIA_PROVIDER=bunny. Today's ingest path downloads the finished
# recording onto our own disk and hands it to LocalMediaProvider; with LiveKit
# producing real files that is a gigabyte per session on the application
# server, which is the exact load self-hosting was rejected for (Q8).
#
# `null` needs no account and no network, and is what the test suite runs on
# (FR-017 · SC-006). LIVEKIT_URL is the wss:// address the browser connects to
# and travels in the join ticket — it is not a secret. The other keys are
# server-side only; the API secret SIGNS every ticket and never travels with
# one. Names here, values never (FR-005).
BROADCAST_PROVIDER=null
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Egress destination: an S3-compatible bucket we own (Cloudflare R2). The
# provider holds this write credential. Deletion is a bucket lifecycle rule,
# not code — a cleanup job is one more thing that fails silently.
LIVEKIT_EGRESS_BUCKET=
LIVEKIT_EGRESS_ENDPOINT=
LIVEKIT_EGRESS_REGION=
LIVEKIT_EGRESS_KEY=
LIVEKIT_EGRESS_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp notification channel (spec 020)
# ---------------------------------------------------------------------------
#
# Empty means SKIPPED, never failed: the channel answers isEnabled() false,
# every delivery is recorded `skipped` with a readable reason, and the product
# behaves exactly as it did before. Names here, values never.
#
# The auth header is a full name and a full value rather than a branch on a
# provider. Our BSP (360dialog) fronts Meta's Cloud API with an identical
# request body, so moving to Meta direct is these two lines and nothing else:
#   WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>
#   WHATSAPP_AUTH_HEADER=Authorization
#   WHATSAPP_API_KEY="Bearer EAA..."
#
# ⚠️ Every message the platform starts must be a template APPROVED by Meta —
# there is no free-form send, because the 24-hour service window is opened by
# the user replying and we receive nothing. See docs/deployment.md: the
# `contact_verification` template is approved FIRST, or no number can ever be
# verified and no message reaches anyone.
WHATSAPP_ENABLED=false
WHATSAPP_BASE_URL=https://waba-v2.360dialog.io
WHATSAPP_AUTH_HEADER=D360-API-KEY
WHATSAPP_API_KEY=
NOTIFICATIONS_DEFAULT_COUNTRY_CODE=974

# Spec 010 — live broadcasting (Laravel Reverb).
#
# ⚠️ ONE OF THESE FOUR IS A SECRET AND THE OTHER THREE ARE NOT, and a rule that
# forbids all of them cannot be satisfied. `REVERB_APP_SECRET` signs and never
# leaves the server. `REVERB_APP_KEY`, the host and the port are what the BROWSER
# dials — the frontend reads them as NEXT_PUBLIC_* — and they open nothing on
# their own: `routes/channels.php` is the guard, not the secrecy of the key. Same
# shape as LiveKit's `iss` claim in 017.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ⚠️ FR-037 IS OFF UNTIL THE KEY FILE IS SERVED, AND THAT IS DELIBERATE.
# IndexNow proves ownership by a text file readable at `{FRONTEND_URL}/{key}.txt`
# — public by protocol, but still the credential that authorises submissions for
# this host, so it lives here and never in the repository. Serving the file is a
# deploy step (drop `{key}.txt` into `frontend/public/`); with the key unset
# `PingSearchEnginesJob` is a silent no-op rather than a 403 on every publish.
# The old `GET /ping?sitemap=` endpoints are gone: Google removed its in January
# 2024 and Bing routes to IndexNow.
INDEXNOW_KEY=
# Only if the file is NOT at the site root. The protocol scopes a key to its own
# path hierarchy, so a key under /.well-known/ may only submit /.well-known/ URLs.
INDEXNOW_KEY_LOCATION=
