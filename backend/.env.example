APP_NAME="EduPlatform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.localhost

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:3000,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Notification delivery runs on its own queues (notifications-high, notifications)
# so a burst of reminders cannot stall the rest of the system. The queue NAMES are
# what gives that separation, and they work on any driver.
#
# Local dev stays on `database`: phpredis is not part of the local setup, and a
# `redis` default here fails every fresh checkout with "Class Redis not found" the
# first time anything is queued. Production runs redis — docker/docker-compose.yml
# sets it — and Horizon is configured for both notification queues.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
# Meilisearch master key — required in production, leave empty for local dev without auth
MEILISEARCH_KEY=

# Horizon (queue dashboard) — requires Redis + pcntl extension
HORIZON_NAME=Mteatch
HORIZON_PATH=horizon
HORIZON_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Keeps one super-admin password across re-seeds. Leave empty for a random
# one printed at seed time. Local/dev only — the seeder skips production.
SUPER_ADMIN_PASSWORD=

# Video pipeline (spec 004). `local` needs no external account and no network:
# it stores on the private disk and streams by range request, which is what
# lets a grant expire mid-file. A commercial provider (Bunny, Cloudflare, Mux)
# is a second file in Modules/Media/Providers plus a case in the provider —
# nothing in the lesson or session logic changes.
MEDIA_PROVIDER=local
MEDIA_DISK=local
MEDIA_MAX_SIZE_BYTES=2147483648
MEDIA_MAX_DURATION_SECONDS=14400
MEDIA_GRANT_TTL_SECONDS=300
MEDIA_GRANT_RENEW_INTERVAL=60
MEDIA_MAX_RENEWALS=480

# Grace period before an admin account without 2FA loses sensitive operations.
TWO_FACTOR_GRACE_DAYS=14
