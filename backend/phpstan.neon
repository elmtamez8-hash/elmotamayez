includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database

    level: 8

    # Modules ship their own migrations; scanning them lets Larastan type model
    # properties (workspace_id, status, ...) instead of reporting them as undefined.
    databaseMigrationsPath:
        - database/migrations
        - app/Modules/Analytics/Database/Migrations
        - app/Modules/Assessments/Database/Migrations
        - app/Modules/CMS/Database/Migrations
        - app/Modules/Certificates/Database/Migrations
        - app/Modules/Community/Database/Migrations
        - app/Modules/Compliance/Database/Migrations
        - app/Modules/Courses/Database/Migrations
        - app/Modules/Gamification/Database/Migrations
        - app/Modules/Identity/Database/Migrations
        - app/Modules/Learning/Database/Migrations
        - app/Modules/LiveSessions/Database/Migrations
        - app/Modules/Marketplace/Database/Migrations
        - app/Modules/Media/Database/Migrations
        - app/Modules/Notifications/Database/Migrations
        - app/Modules/Payments/Database/Migrations
        - app/Modules/Settlement/Database/Migrations
        - app/Modules/Store/Database/Migrations
        - app/Modules/Tenancy/Database/Migrations
        - app/Modules/Whiteboard/Database/Migrations

    # Laravel 13.35 types an eager-load constraint `with(['x' => fn ($q) => ...])`
    # as a bare `Relation<*,*,*>`, which carries no model, so every local scope
    # and builder macro called on it reads as undefined. At runtime `Relation`
    # forwards these to its query builder. Only the model-less wildcard type is
    # ignored; a typed relation is still checked.
    ignoreErrors:
        - '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Relations\\Relation<\*, \*, \*>::\w+\(\)\.$#'
