<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- The product is Arabic-only; tests must exercise the locale that ships. -->
        <env name="APP_LOCALE" value="ar"/>
        <env name="APP_FALLBACK_LOCALE" value="ar"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="SCOUT_DRIVER" value="null"/>
        <!--
            The two provider switches are PINNED, and the day they were not cost five
            green tests their meaning.

            Neither was listed here, so the suite inherited whichever provider the
            developer happened to have configured in `.env`. On 2026-08-17 real
            credentials went in for the first time and five tests that had passed for
            weeks turned red — not because anything regressed, but because they had
            only ever exercised the local provider and nobody knew that was a
            coincidence. A suite whose outcome depends on a file that is not in the
            repository is a suite that agrees with whoever ran it last.

            Pinned to the two providers that need no account and no network: the tests
            that exercise a commercial one set their own config explicitly, which is
            the only way a provider test can be honest anyway.
        -->
        <env name="MEDIA_PROVIDER" value="local"/>
        <env name="BROADCAST_PROVIDER" value="null"/>
        <!--
            The third switch, added by spec 020 and the same lesson a third time.

            The notification channel is not injected: it reads `notifications.whatsapp.*`
            from config at send time, so without this line the suite inherits whatever
            the developer has in `.env`. And the moment real credentials go in — which is
            exactly what the T041 smoke test asks somebody to do — every feature test that
            fires a guardian-type notification runs DeliverNotificationJob inline on the
            `sync` queue, `isEnabled()` answers true, and pest starts making REAL provider
            calls to fixture phone numbers. Not a red test: a bill, a rate budget, and
            messages to numbers nobody owns.

            The tests that exercise the channel set this config explicitly themselves
            (`configureWhatsApp()` in Pest.php), which is the only honest way to test a
            provider anyway.
        -->
        <env name="WHATSAPP_ENABLED" value="false"/>
        <!--
            And the source disk with them: `BunnyMediaProvider::fetchableUrl()` presigns
            through this disk, so a developer with R2 credentials would have the suite
            reaching for a real bucket while one without would not.
        -->
        <env name="BUNNY_SOURCE_DISK" value=""/>
    </php>
</phpunit>
